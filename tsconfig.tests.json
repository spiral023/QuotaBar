{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
