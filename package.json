{
  "name": "quotabar",
  "productName": "QuotaBar",
  "version": "2.4.0",
  "description": "QuotaBar - Electron tray app for AI coding quota usage",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build && electron . --log-debug",
    "dev:watch": "nodemon --watch src --watch assets/fonts --ext ts,js,html,css --delay 1 --exec \"npm run dev\"",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json && node tools/build-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "npm run build && electron-builder --win --publish never",
    "upload:ftp": "node --env-file=.env tools/upload-ftp.mjs",
    "release:local": "npm run package && npm run upload:ftp",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.tests.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.renderer.json",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:electron": "npm run build && node tools/electron-smoke.cjs",
    "test:update": "npm run check:runtime && npm run build && node tools/test-update.cjs",
    "check:runtime": "node tools/check-runtime.mjs",
    "preverify": "npm run check:runtime",
    "predev": "npm run check:runtime",
    "predev:watch": "npm run check:runtime",
    "postinstall": "node node_modules/electron/install.js"
  },
  "keywords": [
    "electron",
    "tray",
    "codex",
    "claude"
  ],
  "author": "Philipp Asanger",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "crc-32": "^1.2.2",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.11",
    "pngjs": "^7.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "chart.js": "^4.6.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.65.1",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=11.21.1 <12"
  },
  "overrides": {
    "minimatch@>=7 <11": "^11.0.8"
  }
}
